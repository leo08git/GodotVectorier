"Camera follow": "<Init>
    <SetVariable Name=\"$Active\" Value=\"1\"/>
    <SetVariable Name=\"$AI\" Value=\"0\" />
    <SetVariable Name=\"Flag1\" Value=\"0\"/>
</Init>
<Loop>
  <Events>
    <Enter/>
  </Events>
  <Actions>
    <Camera Follow=\"_$Model\" />
  </Actions>
</Loop>
",
