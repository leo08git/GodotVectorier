[sub_resource type="GDScript" id="GDScript_2uhpi"]
script/source = "extends Node
class_name Vectorier_model_hunter

@export_group(\"Model\")
@export var model_name = \"Hunter\"
@export var type = \"0\"
@export var color = \"0\"
@export var Birth_spawn = \"DefaultSpawn\"
@export var AI = 1
@export var spawn_time = 0.8
@export var Respawns = \"\" 
@export var ForceBlasts = \"\" 
@export var uses_Tricks = true
@export var uses_Items = true
@export var triggers_Victory = false
@export var triggers_Lose = false
@export var skin = \"hunter\"
@export var AllowedSpawns = \"Respawn\"
@export var Murders = \"Player\"
@export var Arrests = \"Player\"
@export var show_Icon = true
var _data = '<Model Name=\"'

func get_model():
	var data = '<Model Name=\"%s\"' % model_name
	
	if type != \"\":
		data += ' Type=\"%s\"' % type
	if color != \"\":
		data += ' Color=\"%s\"' % color
	if Birth_spawn != \"\":
		data += ' BirthSpawn=\"%s\"' % Birth_spawn

	data += ' AI=\"%s\"' % str(AI)
	data += ' Time=\"%s\"' % str(spawn_time)

	if Respawns != \"\":
		data += ' Respawns=\"%s\"' % Respawns
	if ForceBlasts != \"\":
		data += ' ForceBlasts=\"%s\"' % ForceBlasts

	data += ' Trick=\"%s\"' % ( \"1\" if uses_Tricks else \"0\" )
	data += ' Item=\"%s\"' % ( \"1\" if uses_Items else \"0\" )
	data += ' Victory=\"%s\"' % ( \"1\" if triggers_Victory else \"0\" )
	data += ' Lose=\"%s\"' % ( \"1\" if triggers_Lose else \"0\" )

	data += ' Skins=\"%s\"' % skin

	if AllowedSpawns != \"\":
		data += ' AllowedSpawns=\"%s\"' % AllowedSpawns
	if Murders != \"\":
		data += ' Murders=\"%s\"' % Murders
	if Arrests != \"\":
		data += ' Arrests=\"%s\"' % Arrests
	if show_Icon:
		data += ' Icon=\"1\"'
	elif not show_Icon:
		data += ' Icon=\"0\"'

	data += ' />'
	return data
"

